<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key attr.name="name" attr.type="string" for="node" id="dName"></key>
  <key attr.name="data" attr.type="string" for="node" id="dData"></key>
  <key attr.name="data" attr.type="string" for="edge" id="dData"></key>
  <key attr.name="initial" attr.type="string" for="node" id="dInitial"></key>
  <key for="edge" id="dGeometry"></key>
  <key for="node" id="dGeometry"></key>
  <key for="node" id="dNote"></key>
  <key for="node" id="dVertex"></key>
  <key for="graph" id="dStateMachine"></key>
  <data key="gFormat">Cyberiada-GraphML</data>
  <graph id="G">
    <data key="dStateMachine"></data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">platform/ ArduinoUno

standardVersion/ 1.0

name/ Blinker

name/ Repeated

author/ undefined

lapkiVisual/ true

</data>
    </node>
    <node id="cLED1">
      <data key="dNote">formal</data>
      <data key="dName"> CGML_COMPONENT </data>
      <data key="dData">id/ LED1 

type/ LED

pin/ 12

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="40"/>
      </data>
    </node>
    <node id="init">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <rect x="10" y="10" width="20" height="20"/>
      </data>
    </node>
    <node id="on">
      <data key="dName">On</data>
      <data key="dData">entry/
LED1.on()

</data>
      <data key="dGeometry">
        <rect x="100" y="50" width="200" height="100"/>
      </data>
    </node>
    <node id="off">
      <data key="dName">Off</data>
      <data key="dGeometry">
        <rect x="400" y="50" width="200" height="100"/>
      </data>
    </node>
    <edge id="init-on" source="init" target="on">
      <data key="dData">LED1.off()
</data>
    </edge>
    <edge id="coreMeta-cLED1" source="coreMeta" target="cLED1"></edge>
    <edge id="on-off" source="on" target="off">
      <data key="dData">timer.timeout/
</data>
    </edge>
    <edge id="on-off" source="off" target="on">
      <data key="dData">timer.timeout/
</data>
    </edge>
  </graph>
</graphml>
