<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key id="gFormat" for="graphml" attr.name="format" attr.type="string"/>
  <key id="dName" for="graph" attr.name="name" attr.type="string"/>
  <key id="dName" for="node" attr.name="name" attr.type="string"/>
  <key id="dStateMachine" for="graph" attr.name="stateMachine" attr.type="string"/>
  <key id="dGeometry" for="graph" attr.name="geometry"/>
  <key id="dGeometry" for="node" attr.name="geometry"/>
  <key id="dGeometry" for="edge" attr.name="geometry"/>
  <key id="dNote" for="node" attr.name="note" attr.type="string"/>
  <key id="dVertex" for="node" attr.name="vertex" attr.type="string"/>
  <key id="dData" for="node" attr.name="data" attr.type="string"/>
  <key id="dData" for="edge" attr.name="data" attr.type="string"/>
  <key id="dColor" for="node" attr.name="color" attr.type="string"/>
  <key id="dColor" for="edge" attr.name="color" attr.type="string"/>
  <key id="dPivot" for="edge" attr.name="pivot" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <data key="dStateMachine"/>
    <data key="dName">Light</data>
    <node id="nMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

name/ light

platform/ ArduinoUno

</data>
    </node>
    <node id="init">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <point x="10.000000" y="10.000000"/>
      </data>
    </node>
    <node id="n1">
      <data key="dName">Red</data>
      <data key="dData">entry/
led.on(RED)
</data>
      <data key="dGeometry">
        <rect x="50.000000" y="50.000000" width="100.000000" height="60.000000"/>
      </data>
    </node>
    <node id="n2">
      <data key="dName">Yellow</data>
      <data key="dData">entry/
led.on(YELLOW)
</data>
      <data key="dGeometry">
        <rect x="250.000000" y="50.000000" width="100.000000" height="60.000000"/>
      </data>
    </node>
    <node id="n3">
      <data key="dName">Green</data>
      <data key="dData">entry/
led.on(GREEN)
</data>
      <data key="dGeometry">
        <rect x="450.000000" y="50.000000" width="100.000000" height="60.000000"/>
      </data>
    </node>
    <node id="n5">
      <data key="dName">Night</data>
      <data key="dGeometry">
        <rect x="50.000000" y="250.000000" width="300.000000" height="200.000000"/>
      </data>
      <graph id="n5:">
        <node id="n5::n1">
          <data key="dName">Dark</data>
          <data key="dData">entry/
led.off()
</data>
          <data key="dGeometry">
            <rect x="20.000000" y="40.000000" width="100.000000" height="60.000000"/>
          </data>
        </node>
      </graph>
    </node>
    <node id="c1">
      <data key="dNote">informal</data>
      <data key="dData">the main cycle</data>
      <data key="dGeometry">
        <rect x="450.000000" y="150.000000" width="120.000000" height="40.000000"/>
      </data>
    </node>
    <edge id="init-n1" source="init" target="n1"/>
    <edge id="n1-n2" source="n1" target="n2">
      <data key="dData">TICK/
timer.start(3000)
</data>
    </edge>
    <edge id="n2-n3" source="n2" target="n3">
      <data key="dData">TICK/
</data>
    </edge>
    <edge id="n3-n1" source="n3" target="n1">
      <data key="dData">TICK/
</data>
    </edge>
    <edge id="n1-n5" source="n1" target="n5">
      <data key="dData">NIGHT/
</data>
    </edge>
    <edge id="n5-n1" source="n5" target="n1">
      <data key="dData">DAY/
</data>
    </edge>
    <edge id="c1-n1" source="c1" target="n1">
      <data key="dPivot"/>
    </edge>
  </graph>
</graphml>
